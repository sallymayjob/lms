# ═══════════════════════════════════════════════════════════════════════════
# RWR Group Slack LMS — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in all required values:
#   cp .env.template .env
#   nano .env
#
# Variables marked [AUTO] are auto-generated by setup.sh if left empty.
# Variables marked [REQUIRED] must be filled in before running setup.sh.
# ═══════════════════════════════════════════════════════════════════════════

# ─── DOMAIN ─────────────────────────────────────────────────────────────────
# Your Hostinger VPS domain or subdomain pointing to this server.
# An A record in DNS must already resolve to this server's IP before running
# setup.sh (required for Let's Encrypt SSL certificate issuance).
# Example: lms.rwrgroup.com
DOMAIN=lms.yourdomain.com                          # [REQUIRED]

# Email used for Let's Encrypt SSL certificate notifications.
SSL_EMAIL=admin@yourdomain.com                     # [REQUIRED]

# ─── N8N ────────────────────────────────────────────────────────────────────
# Enable HTTP Basic Auth to protect the n8n editor UI.
N8N_BASIC_AUTH_ACTIVE=true

# Username for the n8n admin web interface.
N8N_BASIC_AUTH_USER=admin                          # [REQUIRED]

# Password for the n8n admin web interface. Minimum 12 characters.
# Leave empty to have setup.sh generate a strong password.
N8N_BASIC_AUTH_PASSWORD=                           # [REQUIRED or AUTO]

# 32-character hex encryption key used by n8n to encrypt stored credentials.
# CRITICAL: Back this up. If lost, all stored credentials are unrecoverable.
# Leave empty to have setup.sh auto-generate a secure value.
N8N_ENCRYPTION_KEY=                                # [AUTO]

# Timezone for n8n schedulers. See: https://momentjs.com/timezone/
GENERIC_TIMEZONE=Pacific/Auckland

# Internal n8n settings (derived from DOMAIN — do not change these manually)
N8N_HOST=${DOMAIN}
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://${DOMAIN}/

# ─── POSTGRESQL ─────────────────────────────────────────────────────────────
# PostgreSQL database user. This user owns the n8n schema.
POSTGRES_USER=n8n

# PostgreSQL password. Leave empty to auto-generate a secure random password.
POSTGRES_PASSWORD=                                 # [AUTO]

# PostgreSQL database name.
POSTGRES_DB=n8n

# Internal connection settings (used by n8n — do not change these).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_HOST=${POSTGRES_HOST}
DB_POSTGRESDB_PORT=${POSTGRES_PORT}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# ─── SLACK ──────────────────────────────────────────────────────────────────
# Slack Bot Token — starts with xoxb-
# Location: Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=                                   # [REQUIRED]

# Slack Signing Secret — 32-character hex string
# Location: Slack App > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=                              # [REQUIRED]

# Incoming Webhook URL for posting admin alerts to a private Slack channel.
# Location: Slack App > Incoming Webhooks > Add New Webhook to Workspace
# Format: https://hooks.slack.com/services/T.../B.../...
SLACK_ADMIN_WEBHOOK_URL=                           # [REQUIRED]

# Slack Channel ID (not name!) for admin/monitoring alerts.
# How to find it: Right-click the channel in Slack > View Channel Details >
#   scroll to bottom — the ID starts with C (e.g. C07ABCDEF12)
LMS_ADMIN_CHANNEL=                                 # [REQUIRED]

# ─── GOOGLE / GEMINI ────────────────────────────────────────────────────────
# Google Gemini API key for AI content QA (Agents 09, 17).
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                                    # [REQUIRED]

# Google Sheets document ID for the nightly LMS data backup (Agent 14).
# Found in the Sheets URL: docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEETS_BACKUP_ID=                           # [REQUIRED]

# Google Sheets document ID for the Lesson content source of truth (Agents 16–18).
# Must contain tabs: Lessons, QA_Log, Pipeline_Status, Checksums
LESSONS_SHEET_ID=                                  # [REQUIRED]

# Webhook URL for Google Drive — used by Agent 15 to receive assignment file links.
# This is a Google Apps Script webhook or Drive API trigger endpoint.
ASSIGNMENT_DRIVE_WEBHOOK_URL=                      # [REQUIRED]

# ─── CONTENT FACTORY ────────────────────────────────────────────────────────
# Secret token that must be sent in the X-Publish-Token header to trigger
# Agent 18 (Lesson Publisher). Generate a long random string.
# Leave empty to auto-generate during setup.
PUBLISH_SECRET=                                    # [AUTO]

# ─── NOTION (Optional) ──────────────────────────────────────────────────────
# Set to true to enable Notion metadata sync from Agent 18.
NOTION_SYNC_ENABLED=false

# Notion Lessons database ID (from the Notion database URL).
NOTION_LESSONS_DB_ID=565f1776-df27-461b-99e3-b70b2ee11dd2
